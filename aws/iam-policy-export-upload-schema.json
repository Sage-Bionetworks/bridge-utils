{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeAndExportUploadSchemaTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:ExportTableToPointInTime"
      ],
      "Resource": "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/<TABLE_NAME>"
    },
    {
      "Sid": "DescribeUploadSchemaExports",
      "Effect": "Allow",
      "Action": "dynamodb:DescribeExport",
      "Resource": "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/<TABLE_NAME>/export/*"
    },
    {
      "Sid": "ReadWriteExportBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::<BUCKET_NAME>/<S3_PREFIX>/*"
    },
    {
      "Sid": "ListExportBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<BUCKET_NAME>",
      "Condition": {
        "StringLike": {
          "s3:prefix": "<S3_PREFIX>/*"
        }
      }
    }
  ]
}
